###> google oauth ###
# Web OAuth client (type: Web application) — "Sign in with Google" on the website.
# Google Cloud Console → Credentials → Web client → Authorized redirect URIs must include
# the EXACT value of GOOGLE_OAUTH_REDIRECT_URI below (copy/paste, no trailing slash).
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/connect/google/check
GOOGLE_OAUTH_CLIENT_ID=change-me
GOOGLE_OAUTH_CLIENT_SECRET=change-me
# Firebase web client ID (client_type 3 in google-services.json) — mobile app only, not this redirect.
GOOGLE_MOBILE_WEB_CLIENT_ID=844470069577-g2mcsv5orb4i1p2gj9m4ldmcvn4hnu0i.apps.googleusercontent.com
###< google oauth ###
