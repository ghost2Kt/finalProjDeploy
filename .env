###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Brevo SMTP (recommended): keep MAILER_DSN empty and use SMTP user/password from the same Brevo SMTP key row.
# Login example: a56fab001@smtp-brevo.com (from Brevo "SMTP & API" page).
MAILER_SMTP_USER=change-me@smtp-brevo.com
MAILER_SMTP_PASSWORD=change-me
MAILER_DSN=
MAILER_FROM_EMAIL=drielwanmanlupig@gmail.com
MAILER_FROM_NAME=AGRINEST
###< symfony/mailer ###

