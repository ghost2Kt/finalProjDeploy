{# Activity logs table (was public/js/logs-table.js) #}
<script>
{% verbatim %}
document.addEventListener("DOMContentLoaded", function () {
    const table = document.getElementById("logsTable");
    if (!table) return;

    const tbody = table.querySelector("tbody");
    const rows = Array.from(tbody.querySelectorAll("tr"));

    const lengthSelect = document.getElementById("logsPageLength");
    const pagination = document.getElementById("logsPagination");
    const pageInfo = document.getElementById("logsPageInfo");

    let filteredRows = rows.slice();
    let currentPage = 1;

    function makeButton(label, page, disabled, active) {
        const btn = document.createElement("button");
        btn.textContent = label;
        btn.className = "page-btn" + (active ? " is-active" : "");
        btn.disabled = !!disabled;
        if (!disabled) {
            btn.addEventListener("click", () => {
                currentPage = page;
                render();
            });
        }
        return btn;
    }

    function render() {
        const pageSize = parseInt(lengthSelect.value, 10) || 10;
        const total = filteredRows.length;
        const totalPages = Math.max(1, Math.ceil(total / pageSize));
        if (currentPage > totalPages) currentPage = totalPages;
        const start = (currentPage - 1) * pageSize;
        const end = start + pageSize;

        rows.forEach((r) => (r.style.display = "none"));
        filteredRows.slice(start, end).forEach((r) => (r.style.display = ""));

        if (pageInfo) {
            const showingStart = total === 0 ? 0 : start + 1;
            const showingEnd = Math.min(end, total);
            pageInfo.textContent = `Showing ${showingStart} to ${showingEnd} of ${total} entries`;
        }

        if (pagination) {
            pagination.innerHTML = "";
            if (totalPages <= 1) return;

            pagination.appendChild(makeButton("«", 1, currentPage === 1, false));
            pagination.appendChild(
                makeButton(
                    "‹",
                    Math.max(1, currentPage - 1),
                    currentPage === 1,
                    false
                )
            );

            const maxPages = 7;
            let startPage = Math.max(1, currentPage - 3);
            let endPage = Math.min(totalPages, startPage + maxPages - 1);
            if (endPage - startPage < maxPages - 1)
                startPage = Math.max(1, endPage - maxPages + 1);
            for (let p = startPage; p <= endPage; p++) {
                pagination.appendChild(
                    makeButton(String(p), p, false, p === currentPage)
                );
            }

            pagination.appendChild(
                makeButton(
                    "›",
                    Math.min(totalPages, currentPage + 1),
                    currentPage === totalPages,
                    false
                )
            );
            pagination.appendChild(
                makeButton("»", totalPages, currentPage === totalPages, false)
            );
        }
    }

    lengthSelect.addEventListener("change", () => {
        currentPage = 1;
        render();
    });

    window.agriNestLogsTable = {
        addRowFromHtml(html) {
            const temp = document.createElement("tbody");
            temp.innerHTML = html.trim();
            const tr = temp.querySelector("tr");
            if (!tr) return;
            tbody.insertBefore(tr, tbody.firstChild);
            rows.unshift(tr);
            filteredRows = rows.slice();
            currentPage = 1;
            render();
        },
    };

    render();
});
{% endverbatim %}
</script>
