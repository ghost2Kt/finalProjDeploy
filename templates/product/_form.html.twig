<div class="form-container">
    <h2><i class="bi bi-cart-plus"></i> {{ title|default('Product Form') }}</h2>
    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'class': 'product-form', 'data-turbo': 'false'}}) }}

    <div class="form-grid">
        <div class="form-group">
            <label for="{{ form.name.vars.id }}">
                <i class="bi bi-tag"></i> Product Name
            </label>
            <div class="input-wrapper">
                {{ form_widget(form.name, {
                    'attr': {
                        'class': 'form-control',
                        'placeholder': 'Enter product name'
                    }
                }) }}
            </div>
            {{ form_errors(form.name) }}
        </div>

        <div class="inline-fields">
            <div class="field-half form-group">
                <label for="{{ form.category.vars.id }}">
                    <i class="bi bi-folder"></i> Category
                </label>
                <div class="input-wrapper">
                    {{ form_widget(form.category, {
                        'attr': {
                            'class': 'form-control'
                        }
                    }) }}
                </div>
                {{ form_errors(form.category) }}
            </div>
            <div class="field-half form-group">
                <label for="{{ form.supplier.vars.id }}">
                    <i class="bi bi-truck"></i> Supplier
                </label>
                <div class="input-wrapper">
                    {{ form_widget(form.supplier, {
                        'attr': {
                            'class': 'form-control'
                        }
                    }) }}
                </div>
                {{ form_errors(form.supplier) }}
            </div>
        </div>

        <div class="inline-fields">
            <div class="field-half form-group">
                <label for="{{ form.price.vars.id }}">
                    <i class="bi bi-currency-dollar"></i> Price
                </label>
                <div class="input-wrapper">
                    {{ form_widget(form.price, {
                        'attr': {
                            'class': 'form-control',
                            'placeholder': '0.00',
                            'step': '0.01',
                            'min': '0'
                        }
                    }) }}
                </div>
                {{ form_errors(form.price) }}
            </div>
            <div class="field-half form-group">
                <label for="{{ form.quantity.vars.id }}">
                    <i class="bi bi-box"></i> Quantity
                </label>
                <div class="input-wrapper">
                    {{ form_widget(form.quantity, {
                        'attr': {
                            'class': 'form-control',
                            'placeholder': '0',
                            'min': '0'
                        }
                    }) }}
                </div>
                {{ form_errors(form.quantity) }}
            </div>
        </div>

        <div class="form-group">
            <label for="{{ form.description.vars.id }}">
                <i class="bi bi-file-text"></i> Description
            </label>
            <div class="input-wrapper">
                {{ form_widget(form.description, {
                    'attr': {
                        'class': 'form-control',
                        'placeholder': 'Enter product description',
                        'rows': '4'
                    }
                }) }}
            </div>
            {{ form_errors(form.description) }}
        </div>

        <div class="inline-fields">
            <div class="field-half form-group">
                <label for="{{ form.date.vars.id }}">
                    <i class="bi bi-calendar"></i> Date
                </label>
                <div class="input-wrapper">
                    {{ form_widget(form.date, {
                        'attr': {
                            'class': 'form-control'
                        }
                    }) }}
                </div>
                {{ form_errors(form.date) }}
            </div>
            <div class="field-half form-group">
                <label for="{{ form.image.vars.id }}">
                    <i class="bi bi-image"></i> Product Image
                </label>
                <div class="input-wrapper file-input-wrapper">
                    {{ form_widget(form.image, {
                        'attr': {
                            'class': 'form-control file-input',
                            'accept': 'image/*',
                            'onchange': 'updateFileLabel(this)'
                        }
                    }) }}
                    <label for="{{ form.image.vars.id }}" class="file-input-label" id="fileLabel">
                        <i class="bi bi-cloud-upload"></i> Choose file...
                    </label>
                </div>
                {{ form_errors(form.image) }}
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-circle"></i> {{ button_label|default('Save Product') }}
        </button>
        <a href="{{ path('app_product_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    {{ form_end(form) }}
</div>

<script>
function updateFileLabel(input) {
    const label = document.getElementById('fileLabel');
    if (input.files && input.files.length > 0) {
        label.textContent = input.files[0].name;
        label.style.color = '#28a745';
    } else {
        label.textContent = 'Choose file...';
        label.style.color = '#666';
    }
}
</script>
