{% extends 'admin/base_admin.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block stylesheets %}
  {{ parent() }}
{% endblock %}

{% block admin_content %}
  <div class="dashboard-header">
    <h1><i class="bi bi-speedometer2"></i> Admin Dashboard</h1>
    <p class="dashboard-subtitle">Welcome back! Here's an overview of your system.</p>
  </div>

  <div
    id="dashboardStatsGrid"
    class="stats-grid"
    data-poll-url="{{ path('app_admin_dashboard_live_poll') }}"
    data-ws-config-url="{{ path('app_admin_orders_live_ws_config') }}">
    <div class="stat-card stat-card-users">
      <div class="stat-icon">
        <i class="bi bi-people-fill"></i>
      </div>
      <div class="stat-content">
        <h3>Total Users</h3>
        <div class="stat-number" id="dashStatUsers">{{ totalUsers }}</div>
        <a href="{{ path('app_admin_users_index') }}" class="stat-link">
          <i class="bi bi-arrow-right-circle"></i> View All Users
        </a>
      </div>
    </div>

    <div class="stat-card stat-card-staff">
      <div class="stat-icon">
        <i class="bi bi-person-badge-fill"></i>
      </div>
      <div class="stat-content">
        <h3>Total Staff</h3>
        <div class="stat-number" id="dashStatStaff">{{ totalStaff }}</div>
        <a href="{{ path('app_admin_users_index', {'role': 'staff'}) }}" class="stat-link">
          <i class="bi bi-arrow-right-circle"></i> View Staff Users
        </a>
      </div>
    </div>

    <div class="stat-card stat-card-products">
      <div class="stat-icon">
        <i class="bi bi-cart-fill"></i>
      </div>
      <div class="stat-content">
        <h3>Total Products</h3>
        <div class="stat-number" id="dashStatProducts">{{ totalProducts }}</div>
        <a href="{{ path('app_admin_products_index') }}" class="stat-link">
          <i class="bi bi-arrow-right-circle"></i> View All Products
        </a>
      </div>
    </div>

    <div class="stat-card stat-card-categories">
      <div class="stat-icon">
        <i class="bi bi-folder-fill"></i>
      </div>
      <div class="stat-content">
        <h3>Total Categories</h3>
        <div class="stat-number" id="dashStatCategories">{{ totalCategories }}</div>
        <a href="{{ path('app_admin_categories_index') }}" class="stat-link">
          <i class="bi bi-arrow-right-circle"></i> View All Categories
        </a>
      </div>
    </div>

    <div class="stat-card stat-card-suppliers">
      <div class="stat-icon">
        <i class="bi bi-truck"></i>
      </div>
      <div class="stat-content">
        <h3>Total Suppliers</h3>
        <div class="stat-number" id="dashStatSuppliers">{{ totalSuppliers }}</div>
        <a href="{{ path('app_admin_suppliers_index') }}" class="stat-link">
          <i class="bi bi-arrow-right-circle"></i> View All Suppliers
        </a>
      </div>
    </div>

    <div class="stat-card stat-card-orders">
      <div class="stat-icon">
        <i class="bi bi-receipt-cutoff"></i>
      </div>
      <div class="stat-content">
        <h3>Total Orders</h3>
        <div class="stat-number" id="dashStatOrders">{{ totalOrders }}</div>
        <a href="{{ path('app_admin_orders_index') }}" class="stat-link">
          <i class="bi bi-arrow-right-circle"></i> View All Orders
        </a>
      </div>
    </div>
  </div>

  <div class="dashboard-section">
    <div class="section-header">
      <div class="section-title-wrapper">
        <h2><i class="bi bi-journal-text"></i> Recent Activity Logs</h2>
        <span class="section-badge">{{ recentLogs|length }} recent</span>
      </div>
      <a href="{{ path('app_admin_logs_index') }}" class="view-all-link">
        View All <i class="bi bi-arrow-right"></i>
      </a>
    </div>
    
    <div class="logs-card">
      {% if recentLogs|length > 0 %}
        <div class="logs-timeline">
          {% for log in recentLogs %}
            <div class="timeline-item">
              <div class="timeline-marker">
                {% if log.action == 'Create' %}
                  <div class="marker-icon marker-create">
                    <i class="bi bi-plus-circle"></i>
                  </div>
                {% elseif log.action == 'Update' %}
                  <div class="marker-icon marker-update">
                    <i class="bi bi-pencil"></i>
                  </div>
                {% elseif log.action == 'Delete' %}
                  <div class="marker-icon marker-delete">
                    <i class="bi bi-trash"></i>
                  </div>
                {% elseif log.action == 'Login' %}
                  <div class="marker-icon marker-login">
                    <i class="bi bi-box-arrow-in-right"></i>
                  </div>
                {% elseif log.action == 'Logout' %}
                  <div class="marker-icon marker-logout">
                    <i class="bi bi-box-arrow-right"></i>
                  </div>
                {% else %}
                  <div class="marker-icon">
                    <i class="bi bi-circle"></i>
                  </div>
                {% endif %}
              </div>
              <div class="timeline-content">
                <div class="log-main-info">
                  <div class="log-user-info">
                    <span class="log-email">{{ log.username }}</span>
                    {% if log.role == 'Admin' %}
                      <span class="badge badge-admin">{{ log.role }}</span>
                    {% elseif log.role == 'Staff' %}
                      <span class="badge badge-staff">{{ log.role }}</span>
                    {% else %}
                      <span class="badge badge-user">{{ log.role }}</span>
                    {% endif %}
                  </div>
                  <div class="log-action-info">
                    <span class="log-action-badge log-action-{{ log.action|lower }}">{{ log.action }}</span>
                    {% if log.entityType %}
                      <span class="log-entity">{{ log.entityType }}{% if log.entityId %} #{{ log.entityId }}{% endif %}</span>
                    {% endif %}
                  </div>
                </div>
                <div class="log-time">
                  <i class="bi bi-clock"></i> 
                  <span>{{ log.timestamp|date('M d, Y') }}</span>
                  <span class="time-separator">•</span>
                  <span>{{ log.timestamp|date('H:i:s') }}</span>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="no-logs">
          <div class="no-logs-icon">
            <i class="bi bi-inbox"></i>
          </div>
          <p>No activity logs yet.</p>
          <span class="no-logs-subtitle">Activity will appear here as users interact with the system.</span>
        </div>
      {% endif %}
    </div>
  </div>

  {% include 'admin/stock_logs/_recent.html.twig' %}
  {% include 'includes/inline/_admin_dashboard_live_js.html.twig' %}
{% endblock %}
