{% extends 'base.html.twig' %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .admin-flash { padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; font-weight: 600; }
    .admin-flash--success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
    .admin-flash--error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
  </style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
  <button type="button" class="dashboard-mobile-toggle" aria-label="Toggle dashboard menu" aria-expanded="false">
    <i class="bi bi-list"></i>
  </button>
  <div class="dashboard-sidebar-overlay" aria-hidden="true"></div>
  <aside class="sidebar">
    <button type="button" class="dashboard-sidebar-close" aria-label="Close dashboard menu">
      <i class="bi bi-x-lg"></i>
    </button>
    <div class="logo-container">
      <img src="{{ asset('images/logo6.png') }}" alt="Logo" class="logo">
      <h2>
        {% if is_granted('ROLE_STAFF') and not is_granted('ROLE_ADMIN') %}
          Staff Panel
        {% else %}
          Admin Panel
        {% endif %}
      </h2>
    </div>
    <nav>
      <ul>
        {% if is_granted('ROLE_ADMIN') %}
          <li><a href="{{ path('app_admin_dashboard') }}"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
          <li><a href="{{ path('app_admin_users_index') }}"><i class="bi bi-people"></i> Users</a></li>
          <li><a href="{{ path('app_admin_logs_index') }}"><i class="bi bi-journal-text"></i> Activity Logs</a></li>
        {% elseif is_granted('ROLE_STAFF') %}
          <li><a href="{{ path('app_staff_dashboard') }}"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
        {% endif %}
        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
          <li><a href="{{ path('app_admin_stock_logs_index') }}"><i class="bi bi-box-seam"></i> Stock Logs</a></li>
          <li><a href="{{ path('app_admin_products_index') }}"><i class="bi bi-box"></i> Products</a></li>
          <li><a href="{{ path('app_admin_categories_index') }}"><i class="bi bi-tags"></i> Category</a></li>
          <li><a href="{{ path('app_admin_suppliers_index') }}"><i class="bi bi-truck"></i> Suppliers</a></li>
          <li><a href="{{ path('app_admin_orders_index') }}"><i class="bi bi-receipt"></i> Orders</a></li>
          <li><a href="{{ path('app_profile') }}"><i class="bi bi-person"></i> Profile</a></li>
        {% endif %}
      </ul> 
    </nav>
    <div class="logout-button">
      <a href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right"></i> Logout</a>
    </div>
  </aside>

  <main class="dashboard-main">
    {% for message in app.flashes('success') %}
      <div class="admin-flash admin-flash--success" role="status">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
      <div class="admin-flash admin-flash--error" role="alert">{{ message }}</div>
    {% endfor %}
    {% block admin_content %}{% endblock %}
  </main>
</div>
<script>
(() => {
  const container = document.querySelector('.dashboard-container');
  if (!container) return;

  const body = document.body;
  const toggle = container.querySelector('.dashboard-mobile-toggle');
  const overlay = container.querySelector('.dashboard-sidebar-overlay');
  const sidebar = container.querySelector('.sidebar');
  const closeBtn = container.querySelector('.dashboard-sidebar-close');
  if (!toggle || !overlay || !sidebar) return;

  const closeSidebar = () => {
    body.classList.remove('dashboard-sidebar-open');
    toggle.setAttribute('aria-expanded', 'false');
  };

  // Always start closed on page load/navigation.
  closeSidebar();

  toggle.addEventListener('click', () => {
    const isOpen = body.classList.toggle('dashboard-sidebar-open');
    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  overlay.addEventListener('click', closeSidebar);
  closeBtn?.addEventListener('click', closeSidebar);

  sidebar.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (window.innerWidth <= 992) closeSidebar();
    });
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 992) closeSidebar();
  });
})();
</script>
{% endblock %}