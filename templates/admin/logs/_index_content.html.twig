<div class="page-header">
    <h1><i class="bi bi-journal-text"></i> Activity Logs</h1>
    <div class="header-info">
        <span class="badge badge-info" id="logsTotalBadge">Total: {{ totalLogs }}</span>
    </div>
</div>

<div class="card table-flat-card logs-list-card">
    <div class="filter-section">
        <form method="GET" action="{{ path('app_admin_logs_index') }}" class="filter-form">
            <div class="filter-row">
                <div class="filter-group">
                    <label for="email"><i class="bi bi-envelope"></i> Email</label>
                    <select name="email" id="email" class="form-control">
                        <option value="">All Emails</option>
                        {% for u in allUserEmails %}
                            <option value="{{ u }}" {{ email == u ? 'selected' : '' }}>{{ u }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="filter-group">
                    <label for="action"><i class="bi bi-activity"></i> Action</label>
                    <select name="action" id="action" class="form-control">
                        <option value="">All Actions</option>
                        {% for a in allActions %}
                            <option value="{{ a }}" {{ action == a ? 'selected' : '' }}>{{ a }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="filter-group">
                    <label for="date_from"><i class="bi bi-calendar-event"></i> Date From</label>
                    <input type="date" name="date_from" id="date_from" class="form-control" value="{{ dateFrom }}">
                </div>

                <div class="filter-group">
                    <label for="date_to"><i class="bi bi-calendar-check"></i> Date To</label>
                    <input type="date" name="date_to" id="date_to" class="form-control" value="{{ dateTo }}">
                </div>

                <div class="filter-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                    <a href="{{ path('app_admin_logs_index') }}" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Clear
                    </a>
                </div>
            </div>
        </form>
    </div>

    <div class="table-controls">
        <div class="control-group">
            <label for="logsPageLength" style="font-weight:600;">Show</label>
            <select id="logsPageLength">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <span>entries</span>
        </div>
    </div>

    <div class="table-container">
        <table
            id="logsTable"
            class="styled-table logs-table"
            data-live-enabled="{{ (email == '' and action == '' and dateFrom == '' and dateTo == '') ? '1' : '0' }}"
            data-poll-url="{{ path('app_admin_logs_live_poll') }}"
            data-row-url-base="{{ path('app_admin_logs_live_row', { id: 0 })|slice(0, -1) }}"
            data-ws-config-url="{{ path('app_admin_orders_live_ws_config') }}">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Details</th>
                    <th>Timestamp</th>
                </tr>
            </thead>
            <tbody>
                {% for log in logs %}
                    {% include 'admin/logs/_activity_log_row.html.twig' %}
                {% else %}
                    <tr>
                        <td colspan="7" class="no-data">No logs found.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="table-footer">
        <div id="logsPageInfo" class="page-info"></div>
        <div id="logsPagination"></div>
    </div>
</div>

{% include 'includes/inline/_admin_activity_logs_live_js.html.twig' %}

<script>
function toggleDetails(logId) {
    const details = document.getElementById('details-' + logId);
    if (details.style.display === 'none') {
        details.style.display = 'block';
    } else {
        details.style.display = 'none';
    }
}
</script>

