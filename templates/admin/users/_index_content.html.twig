<div class="page-header">
    <h1><i class="bi bi-people"></i> User List</h1>
    <a href="{{ path('app_admin_user_new') }}" class="btn btn-add"><i class="bi bi-plus-circle"></i> Create New User</a>
</div>

<div class="card table-flat-card users-list-card">
    <div class="table-controls" style="padding-bottom:0;">
        <div class="control-group" style="gap:.5rem; flex-wrap:wrap;">
            <span style="font-weight:600;">Filter:</span>
            <a href="{{ path('app_admin_users_index') }}" class="btn users-filter-btn {{ selectedRole|default('all') == 'all' ? 'btn-success' : 'btn-secondary' }}">All</a>
            <a href="{{ path('app_admin_users_index', {'role': 'admin'}) }}" class="btn users-filter-btn {{ selectedRole|default('all') == 'admin' ? 'btn-success' : 'btn-secondary' }}">Admin</a>
            <a href="{{ path('app_admin_users_index', {'role': 'staff'}) }}" class="btn users-filter-btn {{ selectedRole|default('all') == 'staff' ? 'btn-success' : 'btn-secondary' }}">Staff</a>
            <a href="{{ path('app_admin_users_index', {'role': 'user'}) }}" class="btn users-filter-btn {{ selectedRole|default('all') == 'user' ? 'btn-success' : 'btn-secondary' }}">User</a>
        </div>
    </div>
    <div class="table-controls">
        <div class="control-group">
            <label for="pageLength" style="font-weight:600;">Show</label>
            <select id="pageLength">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <span>entries</span>
        </div>
        <div class="control-group">
            <label for="tableSearch" style="font-weight:600;">Search:</label>
            <input id="tableSearch" type="text" placeholder="Type to filter..." style="min-width:220px;">
        </div>
    </div>
    <table
        id="usersTable"
        class="styled-table"
        data-live-enabled="1"
        data-role-filter="{{ selectedRole|default('all') }}"
        data-poll-url="{{ path('app_admin_users_live_poll') }}"
        data-row-url-base="{{ path('app_admin_users_live_row', { id: 0 })|slice(0, -1) }}"
        data-ws-config-url="{{ path('app_admin_orders_live_ws_config') }}">
        <thead>
            <tr>
                <th>ID</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Date Created</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
                {% include 'admin/users/_user_row.html.twig' %}
            {% else %}
                <tr>
                    <td colspan="6" class="no-data">No users found.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    <div class="table-footer">
      <div id="pageInfo" class="page-info"></div>
      <div id="pagination"></div>
    </div>
</div>

{% include 'includes/inline/_admin_users_live_js.html.twig' %}
