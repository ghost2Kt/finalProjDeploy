<tr data-user-id="{{ user.id }}" class="users-table-row">
    <td>{{ user.id }}</td>
    <td>{{ user.email }}</td>
    <td>
        {% if 'ROLE_ADMIN' in user.roles %}
            <span class="badge badge-admin">Admin</span>
        {% elseif 'ROLE_STAFF' in user.roles %}
            <span class="badge badge-staff">Staff</span>
        {% else %}
            <span class="badge badge-user">User</span>
        {% endif %}
    </td>
    <td>
        {% if user.createdAt %}
            {{ user.createdAt|date('Y-m-d H:i') }}
        {% else %}
            <span style="color: #999;">N/A</span>
        {% endif %}
    </td>
    <td>
        {% if user.isActive %}
            <span class="badge badge-success">Active</span>
        {% else %}
            <span class="badge badge-danger">Disabled</span>
        {% endif %}
    </td>
    <td class="table-actions">
        <a href="{{ path('app_admin_user_edit', {'id': user.id}) }}" class="btn btn-edit icon-btn" title="Edit">
            <i class="bi bi-pencil"></i>
        </a>
        {% if user.isActive %}
            <form method="post" action="{{ path('app_admin_user_disable', {'id': user.id}) }}" style="display:inline-block;" onsubmit="return confirm('Are you sure you want to disable this user?');">
                <input type="hidden" name="_token" value="{{ csrf_token('disable' ~ user.id) }}">
                <button type="submit" class="btn btn-warning icon-btn" title="Disable User">
                    <i class="bi bi-x-circle"></i>
                </button>
            </form>
        {% else %}
            <form method="post" action="{{ path('app_admin_user_enable', {'id': user.id}) }}" style="display:inline-block;" onsubmit="return confirm('Are you sure you want to enable this user?');">
                <input type="hidden" name="_token" value="{{ csrf_token('enable' ~ user.id) }}">
                <button type="submit" class="btn btn-success icon-btn" title="Enable User">
                    <i class="bi bi-check-circle"></i>
                </button>
            </form>
        {% endif %}
        <form method="post" action="{{ path('app_admin_user_delete', {'id': user.id}) }}" style="display:inline-block;" onsubmit="return confirm('Are you sure you want to delete this user? This action cannot be undone.');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
            <button class="btn btn-delete icon-btn" title="Delete">
                <i class="bi bi-trash"></i>
            </button>
        </form>
    </td>
</tr>
