{% extends 'base.html.twig' %}

{% block title %}Checkout - AgriNest{% endblock %}

{% block body %}
{% include 'includes/_navbar_public.html.twig' %}

<div class="collection-page cart-page checkout-page agrinest-flow-page">
    <div class="checkout-hero">
        <div class="checkout-hero__text">
            <p class="checkout-hero__eyebrow"><i class="bi bi-bag-check"></i> Secure checkout</p>
            <h1>Complete your order</h1>
            <p>Review your items, enter your details, and choose how you would like to pay.</p>
        </div>
        <ol class="checkout-steps" aria-label="Checkout progress">
            <li class="checkout-steps__item is-done">
                <span class="checkout-steps__dot"><i class="bi bi-cart3"></i></span>
                <span class="checkout-steps__label">Cart</span>
            </li>
            <li class="checkout-steps__item is-active" aria-current="step">
                <span class="checkout-steps__dot"><i class="bi bi-credit-card"></i></span>
                <span class="checkout-steps__label">Payment</span>
            </li>
            <li class="checkout-steps__item">
                <span class="checkout-steps__dot"><i class="bi bi-check2"></i></span>
                <span class="checkout-steps__label">Done</span>
            </li>
        </ol>
    </div>

    {% if errors is not empty %}
        <div class="checkout-alert checkout-alert--error" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <ul>
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="checkout-layout">
        <main class="checkout-main">
            <form method="post" action="{{ path('app_cart_checkout') }}" class="checkout-form" data-turbo="false">
                <input type="hidden" name="_token" value="{{ csrf_token('cart_checkout') }}">

                <section class="checkout-panel">
                    <div class="checkout-panel__head">
                        <h2><i class="bi bi-person-vcard"></i> Customer details</h2>
                    </div>
                    <div class="checkout-fields">
                        <div class="checkout-field">
                            <label for="customer_name"><i class="bi bi-person"></i> Full name</label>
                            <input id="customer_name" name="customer_name" type="text" class="checkout-input" placeholder="Juan Dela Cruz" value="{{ formData.customer_name|default('') }}" required>
                        </div>
                        <div class="checkout-field">
                            <label for="customer_email"><i class="bi bi-envelope"></i> Email</label>
                            <input id="customer_email" name="customer_email" type="email" class="checkout-input" placeholder="you@email.com" value="{{ formData.customer_email|default('') }}" required>
                        </div>
                        <div class="checkout-field checkout-field--full">
                            <label for="customer_phone"><i class="bi bi-telephone"></i> Phone</label>
                            <input id="customer_phone" name="customer_phone" type="tel" inputmode="numeric" autocomplete="tel" pattern="^\+?[0-9][0-9\s-]{8,18}$" title="Use digits only, with optional +, spaces, or hyphens." class="checkout-input" placeholder="+63 9XX XXX XXXX" value="{{ formData.customer_phone|default('') }}" required>
                        </div>
                    </div>
                </section>

                <section class="checkout-panel checkout-panel--payment">
                    <div class="checkout-panel__head">
                        <h2><i class="bi bi-wallet2"></i> Payment method</h2>
                        <span class="checkout-demo-pill"><i class="bi bi-shield-check"></i> Demo mode</span>
                    </div>
                    <p class="checkout-payment-intro">Choose one option below. No real payment is processed — for development and testing only.</p>

                    <div class="checkout-payment-grid" id="checkout_payment_options" role="radiogroup" aria-label="Payment method">
                        {% for method in paymentMethods %}
                            {% set selected = (formData.payment_method ?? '') == method.id %}
                            {% set icon = 'bi-credit-card-2-front' %}
                            {% set accent = 'card' %}
                            {% if method.id == 'gcash' %}
                                {% set icon = 'bi-phone' %}
                                {% set accent = 'gcash' %}
                            {% elseif method.id == 'cod' %}
                                {% set icon = 'bi-truck' %}
                                {% set accent = 'cod' %}
                            {% endif %}
                            <label
                                class="checkout-pay-card checkout-pay-card--{{ accent }}{{ selected ? ' is-selected' : '' }}"
                                for="payment_method_{{ method.id }}"
                            >
                                <input
                                    type="radio"
                                    name="payment_method"
                                    id="payment_method_{{ method.id }}"
                                    value="{{ method.id }}"
                                    class="checkout-pay-radio"
                                    {{ selected ? 'checked' : '' }}
                                    {{ loop.first ? 'required' : '' }}
                                >
                                <span class="checkout-pay-card__check" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                                <span class="checkout-pay-card__icon" aria-hidden="true"><i class="bi {{ icon }}"></i></span>
                                <span class="checkout-pay-card__body">
                                    <span class="checkout-pay-card__title">{{ method.label }}</span>
                                    <span class="checkout-pay-card__desc">{{ method.description }}</span>
                                </span>
                            </label>
                        {% endfor %}
                    </div>
                    <p id="checkout_payment_error" class="checkout-payment-error" hidden>Please select a payment method.</p>
                </section>

                <div class="checkout-actions">
                    <a href="{{ path('app_cart_index') }}" class="checkout-btn checkout-btn--ghost">
                        <i class="bi bi-arrow-left"></i> Back to cart
                    </a>
                    <button type="submit" class="checkout-btn checkout-btn--primary">
                        <i class="bi bi-check2-circle"></i> Place order · ₱{{ total|number_format(2, '.', ',') }}
                    </button>
                </div>
            </form>
        </main>

        <aside class="checkout-summary">
            <div class="checkout-panel checkout-panel--summary">
                <div class="checkout-panel__head">
                    <h2><i class="bi bi-receipt"></i> Order summary</h2>
                    <span class="checkout-panel__badge">{{ items|length }} item{{ items|length == 1 ? '' : 's' }}</span>
                </div>
                <ul class="checkout-summary-list">
                    {% for item in items %}
                        <li class="checkout-summary-item">
                            <div class="checkout-summary-item__media">
                                {% if item.product.image %}
                                    <img src="{{ asset('uploads/images/' ~ item.product.image) }}" alt="{{ item.product.name }}">
                                {% else %}
                                    <span class="checkout-summary-item__placeholder"><i class="bi bi-image"></i></span>
                                {% endif %}
                            </div>
                            <div class="checkout-summary-item__info">
                                <span class="checkout-summary-item__name">{{ item.product.name }}</span>
                                <span class="checkout-summary-item__meta">Qty {{ item.quantity }} · ₱{{ item.product.price|number_format(2, '.', ',') }} each</span>
                            </div>
                            <span class="checkout-summary-item__subtotal">₱{{ item.subtotal|number_format(2, '.', ',') }}</span>
                        </li>
                    {% endfor %}
                </ul>
                <div class="checkout-summary-total">
                    <span>Total due</span>
                    <strong>₱{{ total|number_format(2, '.', ',') }}</strong>
                </div>
            </div>
        </aside>
    </div>
</div>

{{ include('homepage/_footer.html.twig') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function initCheckoutPaymentUi() {
            var errorEl = document.getElementById('checkout_payment_error');
            var form = document.querySelector('.checkout-form');
            var radios = document.querySelectorAll('.checkout-pay-radio');

            if (!radios.length) {
                return;
            }

            function syncPaymentCards() {
                radios.forEach(function (radio) {
                    var card = radio.closest('.checkout-pay-card');
                    if (!card) {
                        return;
                    }
                    card.classList.toggle('is-selected', radio.checked);
                });
                if (errorEl) {
                    var anyChecked = Array.prototype.some.call(radios, function (r) {
                        return r.checked;
                    });
                    errorEl.hidden = anyChecked;
                }
            }

            radios.forEach(function (radio) {
                radio.addEventListener('change', syncPaymentCards);
            });

            if (form) {
                form.addEventListener('submit', function (e) {
                    var anyChecked = Array.prototype.some.call(radios, function (r) {
                        return r.checked;
                    });
                    if (!anyChecked) {
                        e.preventDefault();
                        if (errorEl) {
                            errorEl.hidden = false;
                        }
                        document.getElementById('checkout_payment_options')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                });
            }

            syncPaymentCards();
        }

        document.addEventListener('DOMContentLoaded', initCheckoutPaymentUi);
        document.addEventListener('turbo:load', initCheckoutPaymentUi);
    </script>
{% endblock %}
